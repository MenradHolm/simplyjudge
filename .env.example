DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=simplyjudge.onrender.com
CSRF_TRUSTED_ORIGINS=https://simplyjudge.onrender.com
SITE_URL=https://simplyjudge.onrender.com
DATABASE_URL=
CLOUDINARY_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
